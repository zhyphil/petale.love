# petale 环境变量模板
# 复制为 .env.local 并填入真实值
# 部署到 Vercel 时，每个 key 都要 vercel env add
# 注意：占位符用 <YOUR_X_KEY> 形式，避开 GitHub secret scanning 误判

# ===== Replicate（AI 出图）=====
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=<YOUR_REPLICATE_API_TOKEN>

# ===== Stripe（支付）=====
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>

# Stripe Price ID（€9.99 单次包）
# 在 Stripe Dashboard → Products → 创建 product → 创建 price
STRIPE_PRICE_ID_EUR=<YOUR_STRIPE_PRICE_ID>

# ===== Supabase（数据库 + 图床）=====
# https://app.supabase.com → 项目 Settings → API
NEXT_PUBLIC_SUPABASE_URL=<YOUR_SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# ===== Resend（邮件）=====
# https://resend.com/api-keys
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
RESEND_FROM_EMAIL=noreply@petale.love

# ===== 站点配置 =====
NEXT_PUBLIC_SITE_URL=https://petale.app
NEXT_PUBLIC_SITE_NAME=petale